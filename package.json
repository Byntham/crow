{
  "name": "crow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "Self-hosted, subscription-authenticated GitHub PR reviews",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "crow": "dist/bin/crow.mjs"
  },
  "scripts": {
    "start": "pnpm build && node dist/bin/crow.mjs run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "test": "node scripts/check.mjs",
    "check": "pnpm typecheck && node scripts/check.mjs",
    "probe": "pnpm build && node dist/bin/crow.mjs doctor --runtime",
    "test:runtime": "pnpm build && node scripts/probe-runtime.mjs && node scripts/probe-recovery.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
