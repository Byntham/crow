[Unit]
Description=Crow automatic pull request reviewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/crow
EnvironmentFile=/opt/crow/.env
Environment=HOME=/home/crow
# Keep Claude's OAuth/config file under the writable path declared below.
Environment=CLAUDE_CONFIG_DIR=/home/crow/.claude
ExecStart=/usr/bin/node /opt/crow/server/crow.mjs
Restart=always
RestartSec=5
User=crow
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/crow/.crow-data /home/crow/.codex /home/crow/.claude

[Install]
WantedBy=multi-user.target
