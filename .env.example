# Crow listens here. Put HTTPS in front of this port with Caddy, nginx, or a tunnel.
PORT=8787
# Keep the HTTP listener private behind your reverse proxy. Set to 0.0.0.0
# only when you deliberately expose it and provide TLS/firewall protection.
CROW_BIND_HOST=127.0.0.1

# codex or claude. The matching CLI must be installed in the image/host.
CROW_PROVIDER=codex
CROW_CLI_PACKAGE=@openai/codex
# For Claude instead: CROW_PROVIDER=claude and
# CROW_CLI_PACKAGE=@anthropic-ai/claude-code@^2.1.259
# Keep API keys out of the reviewer process when using a subscription login.
# Set to 1 only if your CLI is intentionally authenticated by an API key.
CROW_FORWARD_API_KEYS=0

# Values from the GitHub App settings. These relative paths work for both a
# normal install and the Compose example; Compose mounts them as Docker secrets.
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET_FILE=./secrets/webhook-secret
# Compose reads these host-side paths when it creates Docker secrets. Leave
# them pointing at the same files above; non-Docker installs may ignore them.
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET_PATH=./secrets/webhook-secret
# Optional exact GitHub App bot login (for stricter duplicate-marker checks).
# CROW_BOT_LOGIN=crow[bot]
# Direct values also work for a local install; file mounts are preferred on servers.
# For GitHub Enterprise, set both GITHUB_API_URL (including /api/v3) and GITHUB_HOST.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_HOST=github.example.com

# Optional limits.
CROW_MAX_QUEUE=100
CROW_STATE_FILE=./.crow-data/state.json
CROW_MAX_WEBHOOK_BYTES=2097152
CROW_MAX_DIFF_BYTES=4194304
CROW_REVIEW_TIMEOUT_MS=180000
CROW_MAX_PROVIDER_OUTPUT_BYTES=8388608
